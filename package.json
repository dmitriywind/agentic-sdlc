{
  "name": "agentic-sdlc",
  "version": "0.1.0",
  "private": true,
  "description": "Software factory / agentic SDLC: any board, any forge, trunk-based Git; ships as a Claude Code plugin",
  "type": "module",
  "bin": {
    "agentic-sdlc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "scorers",
    "templates",
    "references",
    "docs",
    ".claude-plugin",
    "agents",
    "bin",
    "evals",
    "hooks",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/guide.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "keywords": [
    "software-factory",
    "agentic-sdlc",
    "ai-agents",
    "trunk-based",
    "kanban",
    "github",
    "jira",
    "linear",
    "claude-code-plugin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitriywind/agentic-sdlc.git"
  },
  "bugs": {
    "url": "https://github.com/dmitriywind/agentic-sdlc/issues"
  },
  "homepage": "https://dmitriywind.github.io/agentic-sdlc/guide.html",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.0.0"
  }
}
