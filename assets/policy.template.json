{
  "$schemaVersion": 2,
  "tracker": {
    "adapter": ".agents/skills/agentic-sdlc/scripts/local-tracker.mjs",
    "options": {
      "path": ".agentic-sdlc/tracker.json"
    }
  },
  "runner": {
    "adapter": ".agents/skills/agentic-sdlc/scripts/process-runner.mjs",
    "goal": {
      "enabled": true,
      "maxContinuations": 2
    },
    "workspace": {
      "enabled": true,
      "baseRef": "develop",
      "branchPrefix": "agentic/"
    },
    "routes": {
      "reasoning": {
        "why": "Use the strongest economical reasoning profile appropriate to triage and planning.",
        "primary": "reasoning-primary",
        "fallbacks": []
      },
      "implementation": {
        "why": "Use a tool-capable profile approved to edit and verify this repository.",
        "primary": "implementation-primary",
        "fallbacks": []
      },
      "review": {
        "why": "Use an independent read-only profile, preferably from a different model family.",
        "primary": "review-primary",
        "fallbacks": []
      }
    },
    "profiles": {
      "reasoning-primary": {
        "model": "configure-me",
        "effort": "configure-me",
        "command": "configure-me",
        "args": []
      },
      "implementation-primary": {
        "model": "configure-me",
        "effort": "configure-me",
        "command": "configure-me",
        "args": []
      },
      "review-primary": {
        "model": "configure-me",
        "effort": "configure-me",
        "command": "configure-me",
        "args": []
      }
    }
  },
  "process": {
    "stages": [
      "Ideas",
      "Backlog",
      "Ready",
      "In progress",
      "In review",
      "Done",
      "Live on staging",
      "Live on production",
      "Cancelled"
    ],
    "conditions": [
      "waiting:decision",
      "waiting:dependency"
    ],
    "transitions": [
      {
        "from": "Backlog",
        "to": "Ready",
        "evidence": "triage-ready"
      },
      {
        "from": "Ready",
        "to": "In progress",
        "evidence": "plan-ready"
      },
      {
        "from": "In progress",
        "to": "In review",
        "evidence": "change-open"
      },
      {
        "from": "In review",
        "to": "Done",
        "evidence": "change-merged"
      },
      {
        "from": "Done",
        "to": "Live on staging",
        "evidence": "staging-live"
      },
      {
        "from": "Live on staging",
        "to": "Live on production",
        "evidence": "production-live"
      }
    ],
    "work": [
      {
        "id": "triage",
        "stage": "Backlog",
        "run": "triage",
        "lane": "reasoning",
        "completionEvidence": "triage-ready",
        "produces": [
          "triage-ready"
        ]
      },
      {
        "id": "plan",
        "stage": "Ready",
        "run": "plan",
        "lane": "reasoning",
        "requiresPlan": true,
        "completionEvidence": "plan-ready",
        "produces": [
          "plan-ready"
        ]
      },
      {
        "id": "execute",
        "stage": "In progress",
        "run": "execute",
        "lane": "implementation",
        "requiresChange": true,
        "requiresPullRequest": true,
        "completionEvidence": "change-open",
        "produces": [
          "change-open"
        ]
      },
      {
        "id": "fix-review-findings",
        "stage": "In review",
        "run": "fix",
        "lane": "implementation",
        "requiresChange": true,
        "requiresPullRequest": true,
        "requiresEvidence": [
          "review-findings"
        ],
        "completionEvidence": "fix-published",
        "produces": [
          "fix-published"
        ]
      },
      {
        "id": "review",
        "stage": "In review",
        "run": "review",
        "lane": "review",
        "forbidsEvidence": [
          "review-findings"
        ],
        "completionEvidence": "change-merged",
        "produces": [
          "review-findings",
          "replan-requested",
          "change-merged"
        ]
      }
    ]
  },
  "limits": {
    "maxParallel": 1,
    "maxAttempts": 3,
    "retryBackoffSeconds": 60,
    "intervalSeconds": 600,
    "runTimeoutSeconds": 1800
  },
  "rules": {
    "files": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents/rules/project.md"
    ],
    "context": [
      "AGENTS.md"
    ],
    "protectedPaths": []
  },
  "runtime": {
    "directory": ".agentic-sdlc",
    "enabled": false
  }
}
